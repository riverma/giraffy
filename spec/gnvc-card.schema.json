{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/gnvc/1.0/schema.json",
  "title": "gNVC card",
  "description": "A Nonviolent Communication card in the gNVC format, version 1.x. One card per file. See https://w3id.org/gnvc/1.0. Published under CC0 1.0.",
  "type": "object",
  "required": ["gnvc", "kind", "id", "from", "created", "updated", "observation", "feelings", "needs"],
  "properties": {
    "gnvc": {
      "description": "Format version. Readers accept any 1.x.",
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "kind": { "type": "string", "enum": ["request", "gratitude"] },
    "id": {
      "description": "Minted once by the author, never changes. A UUID is recommended.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "from": { "description": "The author's display name.", "type": "string", "minLength": 1 },
    "to": { "description": "Who the card is for. Omitted or the author's own name for a card to oneself.", "type": "string" },
    "about": { "description": "A short context line.", "type": "string" },
    "summary": { "description": "The four parts assembled into one paragraph.", "type": "string" },
    "observation": { "type": "string" },
    "feelings": { "type": "array", "items": { "type": "string" } },
    "needs": { "type": "array", "items": { "type": "string" } },
    "requests": { "type": "array", "items": { "type": "string" } },
    "status": { "$ref": "#/$defs/state" },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["state", "by", "at"],
        "properties": {
          "state": { "$ref": "#/$defs/state" },
          "by": { "type": "string", "minLength": 1 },
          "at": { "$ref": "#/$defs/timestamp" },
          "note": { "type": "string" }
        }
      }
    },
    "entangled_with": {
      "description": "Pointers to direct neighbours, by id. Links carry no state.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": { "id": { "type": "string", "minLength": 1 } }
      }
    },
    "mapping": {
      "description": "Optional precise mappings. Indices are 0-based into the lists above.",
      "type": "object",
      "properties": {
        "feelings_to_needs": { "$ref": "#/$defs/indexPairs" },
        "requests_to_needs": { "$ref": "#/$defs/indexPairs" }
      }
    },
    "created": { "$ref": "#/$defs/timestamp" },
    "updated": { "$ref": "#/$defs/timestamp" }
  },
  "if": { "properties": { "kind": { "const": "request" } } },
  "then": { "required": ["requests"] },
  "$defs": {
    "state": {
      "type": "string",
      "enum": ["draft", "ready", "shared", "received", "heard", "yes", "no", "maybe", "given", "celebrated", "withdrawn"]
    },
    "timestamp": {
      "description": "ISO-8601, UTC.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?(Z|[+-][0-9]{2}:?[0-9]{2})$"
    },
    "indexPairs": {
      "type": "array",
      "items": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 2, "maxItems": 2 }
    }
  }
}
